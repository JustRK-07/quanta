# ==============================================================================
# Quanta .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# Environment & Secrets
# ------------------------------------------------------------------------------
.env
*.env
.env.*
!.env.example
*serviceAccountKey*.json
*service-account*.json
*firebase-adminsdk*.json
backend/firebase_service_account.json

# ------------------------------------------------------------------------------
# Python
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
env/
backend/.venv/

# Pytest / Coverage
.pytest_cache/
htmlcov/
.coverage
coverage.xml
*.cover

# mypy
.mypy_cache/

# Distribution
*.egg-info/
dist/
build/

# ------------------------------------------------------------------------------
# Flutter / Dart
# ------------------------------------------------------------------------------
quanta_app/build/
quanta_app/.dart_tool/
quanta_app/.flutter-plugins
quanta_app/.flutter-plugins-dependencies
quanta_app/.packages

# Platform-specific generated files
quanta_app/android/.gradle/
quanta_app/android/build/
quanta_app/android/app/google-services.json
quanta_app/ios/Pods/
quanta_app/ios/Runner/GoogleService-Info.plist
quanta_app/ios/.symlinks/
quanta_app/macos/Pods/
quanta_app/macos/Flutter/ephemeral/
quanta_app/linux/flutter/ephemeral/
quanta_app/windows/flutter/ephemeral/
quanta_app/.firebase/

# Flutter test coverage
quanta_app/coverage/

# ------------------------------------------------------------------------------
# IDE / Editor
# ------------------------------------------------------------------------------
.vscode/
!.vscode/settings.json
!.vscode/launch.json
.idea/
*.iml
*.swp
*.swo
*~
*.backup

# ------------------------------------------------------------------------------
# OS files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ------------------------------------------------------------------------------
# Docker
# ------------------------------------------------------------------------------
docker-compose.override.yml

# ------------------------------------------------------------------------------
# Misc
# ------------------------------------------------------------------------------
.history/
static/scans/
backend/static/scans/
*.log
.secrets.baseline
backend/services/flutter_application_1/
test_output.txt
test_image.png

# Firebase per-project config (contains real API keys and project IDs)
quanta_app/firebase.json
quanta_app/lib/firebase_options.dart
!quanta_app/lib/firebase_options.dart
quanta_app/android/app/google-services.json
quanta_app/ios/Runner/GoogleService-Info.plist
quanta_app/macos/Runner/GoogleService-Info.plist

# Local debugging screenshots
*.tmp.png

# Demo videos (regenerate locally; we don't track the binaries by default)
# The video/ folder is kept (with a .gitkeep) so the structure survives;
# the regenerated mp4s in video/ ARE tracked — see the whitelist below.
*.mp4
*.mov
*.webm
videos/

# Whitelist: keep the demo videos in video/ that the build_demo*.py
# scripts produce. Anything dropped in by hand still respects the *.mp4
# rule above.
!video/*.mp4
backend/static/uploads/*
!backend/static/uploads/.gitkeep
