# AI provider used by the backend
GOOGLE_API_KEY=
GROQ_API_KEY=

# Firebase Admin credentials: use either a mounted file or inline JSON.
FIREBASE_CREDENTIALS_FILE=
FIREBASE_CREDENTIALS_JSON=

# MongoDB is optional for local development.
MONGO_URI=

# Deployed Flutter/Vercel origin. Leave blank for local development.
FRONTEND_URL=

# Keep false/unset outside local demos.
ALLOW_DEV_AUTH_BYPASS=false

# Render, Railway, and Docker hosts provide this at runtime.
PORT=8001
